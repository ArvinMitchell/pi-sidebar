{
  "manifest_version": 3,
  "name": "Pi Sidebar",
  "version": "0.2.1",
  "description": "在浏览器侧边栏与本地 Pi agent 对话，可一键总结当前页面。",
  "homepage_url": "https://github.com/ArvinMitchell/pi-sidebar",
  "permissions": [
    "scripting",
    "sidePanel",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/pi-icon-16.png",
    "32": "icons/pi-icon-32.png",
    "48": "icons/pi-icon-48.png",
    "128": "icons/pi-icon-128.png"
  },
  "action": {
    "default_title": "Pi Sidebar",
    "default_icon": {
      "16": "icons/pi-icon-16.png",
      "32": "icons/pi-icon-32.png",
      "48": "icons/pi-icon-48.png",
      "128": "icons/pi-icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}